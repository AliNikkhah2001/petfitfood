{
  "name": "petfitfood",
  "private": true,
  "version": "0.1.0",
  "description": "PetFit (پت‌فیت) commercial storefront monorepo",
  "scripts": {
    "dev": "npm run dev --workspace=@petfit/web",
    "build": "npm run build --workspace=@petfit/web",
    "preview": "npm run preview --workspace=@petfit/web",
    "typecheck": "npm run typecheck --workspace=@petfit/web",
    "cms:migrate": "cd apps/cms && .venv/bin/python manage.py migrate",
    "cms:seed": "cd apps/cms && .venv/bin/python manage.py seed_catalog",
    "cms:dev": "cd apps/cms && .venv/bin/python manage.py runserver 127.0.0.1:8000",
    "cms:up": "docker compose up --build -d",
    "cms:down": "docker compose down",
    "test:e2e": "npm run test:e2e --workspace=@petfit/web"
  },
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  }
}
