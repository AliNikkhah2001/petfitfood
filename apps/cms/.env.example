DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DATABASE_URL=postgres://petfit:petfit@db:5432/petfit
CORS_ALLOWED_ORIGINS=https://alinikkhah2001.github.io,http://127.0.0.1:5173
PETFIT_FRONTEND_URL=https://alinikkhah2001.github.io/petfitfood
PETFIT_EXPOSE_OTP=0

# SMS (Kavenegar) — leave empty to log OTP to console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# Payments (Zarinpal) — leave empty to accept unpaid COD orders
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
ZARINPAL_CALLBACK_URL=https://api.example.com/api/v1/payments/zarinpal/callback/

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@petfit.local
